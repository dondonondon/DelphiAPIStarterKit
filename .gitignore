# Delphi compiler-generated binaries
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.so
*.apk
*.drc
*.map
*.dres
*.rsm
*.tds
*.dcu
*.lib
*.a
*.o
*.ocx

# Delphi autogenerated files
*.cfg
*.hpp
*Resource.rc

# Delphi local files (user-specific)
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk
*.dsv

# Delphi history and backups
__history/
__recovery/
*.~*

# Delphi platform build output (including extensionless Linux executables)
/Win32/
/Win64/
/Win64x/
/Linux64/

# Local build archives and diagnostics
/bin/*.rar
/bin/*.zip
/bin/*.7z
/bin/logs/
/logs/
*.log
*.binlog

# Python tooling caches
__pycache__/
*.pyc
.pytest_cache/

# Castalia statistics (since XE7)
*.stat

# Local runtime configuration and secrets
config.ini
.env
.env.*
!.env.example
!.env.*.example
config.local.ini
config.*.local.ini
/secrets/
*.pfx
*.p12
*.key

# Local orchestrator checkpoints and tool output
/.ai/runs/
/.ai/cache/

# Local bootstrap reference replaced by the project-specific skill package
/initialize-ai-agent-system-codex-copilot.md

# Repository-specific ignores
/docs/*

# Boss dependency manager (https://github.com/HashLoad/boss)
/modules/

# Generated DataSnap proxy output
/bin/proxy/
/proxy/

# Runtime file storage
/bin/files/

# Native client library (users install from official vendor)
/bin/lib/*.dll

# Legacy snapshot directory
/temp-file/

# Empty directory placeholders
sources/shared/types/.gitkeep
sources/shared/middleware/.gitkeep
sources/tests/integration/.gitkeep
sources/tests/unit/.gitkeep
sources/infrastructure/external/.gitkeep
sources/infrastructure/security/.gitkeep
sources/infrastructure/logging/.gitkeep

# Unignored exceptions
!libmysql.dll
!/docs/databases/
!/docs/information/
!/docs/api/
!/docs/bugs/
!/docs/bugs/*.md
!/docs/workflows/
